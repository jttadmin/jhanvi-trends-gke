# Terraform owns the platform: Traefik, cert-manager, Argo CD and the
# observability stack (observability.tf). Your microservices, Postgres,
# MongoDB, Redis and Kafka keep flowing from the app repo through Argo CD.

# ---------- Traefik (ingress) on the static IP ----------
resource "helm_release" "traefik" {
  name             = "traefik"
  repository       = "https://traefik.github.io/charts"
  chart            = "traefik"
  version          = var.traefik_chart_version
  namespace        = "traefik"
  create_namespace = true

  values = [yamlencode({
    service = {
      spec = {
        type                  = "LoadBalancer"
        loadBalancerIP        = google_compute_address.ingress.address
        externalTrafficPolicy = "Local" # keeps real client IPs for your logs
      }
    }
    ingressClass = {
      enabled        = true
      isDefaultClass = true
    }
    ports = {
      web = {
        allowACMEByPass = true # let cert-manager's HTTP-01 challenge through before the redirect
        http = {
          redirections = {
            entryPoint = {
              to        = "websecure"
              scheme    = "https"
              permanent = true
            }
          }
        }
      }
    }
    nodeSelector = { workload = "stateful" } # keep ingress off Spot nodes

    # ---- observability ----
    metrics = {
      prometheus = {
        service        = { enabled = true }
        serviceMonitor = { enabled = true }
      }
    }
    log       = { format = "json" }
    accessLog = { enabled = true, format = "json" }
    tracing = {
      otlp = {
        enabled = true
        grpc = {
          enabled  = true
          endpoint = "${local.otel_gw_svc}:4317"
          insecure = true
        }
      }
    }
  })]

  depends_on = [helm_release.kube_prometheus_stack]
}

# ---------- cert-manager ----------
resource "helm_release" "cert_manager" {
  name             = "cert-manager"
  repository       = "https://charts.jetstack.io"
  chart            = "cert-manager"
  version          = var.cert_manager_chart_version
  namespace        = "cert-manager"
  create_namespace = true

  values = [yamlencode({
    crds = { enabled = true }
    prometheus = {
      enabled        = true
      servicemonitor = { enabled = true }
    }
  })]

  depends_on = [helm_release.kube_prometheus_stack]
}

# ---------- Argo CD ----------
resource "helm_release" "argocd" {
  name             = "argocd"
  repository       = "https://argoproj.github.io/argo-helm"
  chart            = "argo-cd"
  version          = var.argocd_chart_version
  namespace        = "argocd"
  create_namespace = true

  values = concat([yamlencode({
    global = {
      domain = var.argocd_host
    }
    configs = {
      params = {
        "server.insecure" = true # TLS terminates at Traefik
      }
    }
    controller = {
      metrics = { enabled = true, serviceMonitor = { enabled = true } }
    }
    repoServer = {
      metrics = { enabled = true, serviceMonitor = { enabled = true } }
    }
    applicationSet = {
      metrics = { enabled = true, serviceMonitor = { enabled = true } }
    }
    server = {
      metrics = { enabled = true, serviceMonitor = { enabled = true } }
      ingress = {
        enabled          = true
        ingressClassName = "traefik"
        annotations = {
          "cert-manager.io/cluster-issuer" = "letsencrypt-prod"
        }
        tls = true
      }
    }
  })], local.argocd_notifications_values)

  depends_on = [helm_release.traefik]
}

# ---------- Argo CD notifications -> GitHub (automatic promotion) ----------
# When an Application subscribed to "on-deployed-dispatch" (generated by the ApplicationSet in charts/bootstrap) has
# finished a sync that Succeeded (PostSync smoke test included) and is Healthy, Argo CD POSTs a
# repository_dispatch event to GitHub, once per Git revision. promote.yaml turns it into a PR to the
# next environment. Skipped entirely while argocd_github_dispatch_token is null.
locals {
  github_repo_slug = trimsuffix(trimprefix(var.gitops_repo_url, "https://github.com/"), ".git")

  # An unset GitHub secret arrives as "", so treat empty the same as null.
  argocd_dispatch_enabled = var.argocd_github_dispatch_token != null && var.argocd_github_dispatch_token != ""

  argocd_notifications_values = local.argocd_dispatch_enabled ? [yamlencode({
    notifications = {
      enabled = true
      secret = {
        items = {
          github-dispatch-token = var.argocd_github_dispatch_token
        }
      }
      notifiers = {
        "service.webhook.github-dispatch" = <<-EOT
          url: https://api.github.com/repos/${local.github_repo_slug}/dispatches
          headers:
            - name: Authorization
              value: Bearer $github-dispatch-token
            - name: Accept
              value: application/vnd.github+json
            - name: X-GitHub-Api-Version
              value: "2022-11-28"
        EOT
      }
      templates = {
        "template.github-dispatch-deployed" = <<-EOT
          webhook:
            github-dispatch:
              method: POST
              body: |
                {"event_type": "argocd-deployed", "client_payload": {"env": "{{index .app.metadata.labels "env"}}", "app": "{{.app.metadata.name}}", "revision": "{{.app.status.operationState.syncResult.revision}}"}}
        EOT
      }
      triggers = {
        "trigger.on-deployed-dispatch" = <<-EOT
          - description: App synced (PostSync smoke test passed) and healthy
            when: app.status.operationState != nil and app.status.operationState.phase in ['Succeeded'] and app.status.health.status == 'Healthy'
            oncePer: app.status.operationState?.syncResult?.revision
            send: [github-dispatch-deployed]
        EOT
      }
    }
  })] : []
}

# ---------- Private repo credentials for Argo CD ----------
resource "kubernetes_secret_v1" "gitops_repo" {
  metadata {
    name      = "jhanvi-trends-repo"
    namespace = "argocd"
    labels = {
      "argocd.argoproj.io/secret-type" = "repository"
    }
  }

  data = {
    type     = "git"
    url      = var.gitops_repo_url
    username = var.gitops_repo_username
    password = var.gitops_repo_token
  }

  depends_on = [helm_release.argocd]
}

# ---------- ClusterIssuers + AppProject + ApplicationSet ----------
# Shipped as a tiny local chart so Terraform doesn't need the CRDs at plan time.
# The ApplicationSet turns every folder matching gitops_charts_path into one Application for this env.
resource "helm_release" "bootstrap" {
  name      = "jhanvi-bootstrap"
  chart     = "${path.module}/charts/bootstrap"
  namespace = "argocd"

  values = [yamlencode({
    letsencryptEmail = var.letsencrypt_email
    gitops = {
      repoURL        = var.gitops_repo_url
      targetRevision = var.gitops_target_revision
      env            = var.gitops_env
      chartsPath     = var.gitops_charts_path
    }
    project = {
      namespaces  = ["jhanvi-trends"]
      syncWindows = var.argocd_sync_windows
    }
  })]

  depends_on = [
    helm_release.cert_manager,
    helm_release.argocd,
    kubernetes_secret_v1.gitops_repo,
  ]
}
