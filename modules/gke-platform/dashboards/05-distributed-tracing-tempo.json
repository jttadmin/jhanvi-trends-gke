          "expr": "histogram_quantile(0.95, sum by (le, client, server) (rate(traces_service_graph_request_server_seconds_bucket{server=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{client}} \u2192 {{server}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
